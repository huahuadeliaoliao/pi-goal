{
	"name": "pi-goal-moonland",
	"version": "0.1.0",
	"description": "Goal mode for the pi coding agent: one persistent objective, worked autonomously across turns until it is verifiably done.",
	"type": "module",
	"license": "MIT",
	"author": "huahuadeliaoliao",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/huahuadeliaoliao/pi-goal.git"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"goal",
		"goal-mode",
		"autonomous"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"files": [
		"index.ts",
		"state.ts",
		"prompts.ts",
		"skills"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		],
		"skills": [
			"./skills"
		]
	},
	"scripts": {
		"check": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "node --test test/*.test.ts",
		"prepublishOnly": "npm run lint && npm run check && npm test"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-agent-core": {
			"optional": true
		},
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@earendil-works/pi-agent-core": "0.85.1",
		"@earendil-works/pi-ai": "0.85.1",
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@earendil-works/pi-tui": "0.85.1",
		"@types/node": "^24.0.0",
		"typebox": "1.3.7",
		"typescript": "^5.5.0"
	}
}
